<ui:FluentWindow x:Class="AIReviewDesk.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="AI Review Desk" Width="1180" Height="820" MinWidth="900" MinHeight="620"
 WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True"
 Loaded="OnLoaded" Activated="OnActivated">
 <ui:FluentWindow.Resources>
  <Style x:Key="ProjectWorkspaceTab" TargetType="RadioButton">
   <Setter Property="Padding" Value="12,8" />
   <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
     <ContentPresenter />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" /></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </ui:FluentWindow.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <ui:TitleBar Title="AI Review Desk" ShowMaximize="True">
   <ui:TitleBar.TrailingContent>
    <TextBlock Text="{Binding CopilotAllowanceCompact}" ToolTip="{Binding CopilotAllowanceTooltip}"
     Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"
     HorizontalAlignment="Right" MaxWidth="340" TextTrimming="CharacterEllipsis" Margin="8,0,12,0" />
   </ui:TitleBar.TrailingContent>
  </ui:TitleBar>
  <Grid Grid.Row="1" IsEnabled="{Binding Interactive}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="252" MinWidth="190" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" MinWidth="420" /></Grid.ColumnDefinitions>
   <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="16,20,16,16">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="YOUR WORKSPACE" FontSize="11" FontWeight="SemiBold" Style="{StaticResource Caption}" Margin="12,0,0,16" />
      <ui:Button Content="＋  Add project" Appearance="Primary" HorizontalAlignment="Stretch" Click="OnAdd" AutomationProperties.AutomationId="AddProject" />
      <StackPanel Margin="0,20,0,12">
       <ui:Button Content="Profiles" Tag="Profiles" Click="OnNavigate" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,4" />
       <ui:Button Content="Settings" Tag="Settings" Click="OnNavigate" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
      </StackPanel>
      <TextBlock Text="PROJECTS" FontSize="11" FontWeight="SemiBold" Style="{StaticResource Caption}" Margin="12,8,0,10" />
     </StackPanel>
     <TextBlock DockPanel.Dock="Bottom" Text="AI Review Desk  ·  Preview 0.1" Style="{StaticResource Caption}" FontSize="11" Margin="12,16,0,0" />
     <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding Selected, Mode=OneWay}" SelectionChanged="OnProjectSelected" MouseLeftButtonUp="OnProjectClicked" KeyDown="OnProjectKeyDown" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Registered projects">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Height" Value="38" /><Setter Property="MinHeight" Value="0" /><Setter Property="Margin" Value="0,2" /><Setter Property="Padding" Value="8,2" /><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" /></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
       <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="3,5" />
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" ShowsPreview="False" />
   <ScrollViewer x:Name="MainContentScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,22,32,28">
     <Border Style="{StaticResource Card}" Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
     </Border>
     <Border Style="{StaticResource Card}" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" BorderBrush="#D99043">
      <StackPanel><TextBlock Text="Something needs attention" FontWeight="SemiBold" Margin="0,0,0,6" /><TextBlock Text="{Binding Error}" TextWrapping="Wrap" /></StackPanel>
     </Border>
     <StackPanel Orientation="Horizontal" Visibility="{Binding ShowProjectTabs, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,20">
      <RadioButton Style="{StaticResource ProjectWorkspaceTab}" Content="Overview" GroupName="ProjectTabs" IsChecked="{Binding OverviewSelected, Mode=OneWay}" Tag="Projects" Click="OnProjectTab" Margin="0,0,20,0" />
      <RadioButton Style="{StaticResource ProjectWorkspaceTab}" Content="Reviews" GroupName="ProjectTabs" IsChecked="{Binding ReviewsSelected, Mode=OneWay}" Tag="Reviews" Click="OnProjectTab" />
     </StackPanel>
     <StackPanel Visibility="{Binding ShowProjects, Converter={StaticResource BoolVisibility}}">
      <StackPanel Visibility="{Binding Empty, Converter={StaticResource BoolVisibility}}" Margin="16,72,16,0">
       <ui:SymbolIcon Symbol="FolderOpen24" FontSize="52" HorizontalAlignment="Left" Margin="0,0,0,24" />
       <TextBlock Text="A clear view of your next review" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
       <TextBlock Text="Bring your repositories together. See what changed, choose useful defaults, and get ready for independent code review." Style="{StaticResource Caption}" FontSize="15" Margin="0,14,0,24" MaxWidth="540" HorizontalAlignment="Left" />
       <ui:Button Content="Add your first project" Appearance="Primary" Click="OnAdd" />
       <TextBlock Text="Choose any folder inside a Git repository. Your project settings stay on this PC." Style="{StaticResource Caption}" Margin="0,20,0,0" />
      </StackPanel>
      <StackPanel Visibility="{Binding HasProject, Converter={StaticResource BoolVisibility}}">
       <TextBlock Text="PROJECT OVERVIEW" Style="{StaticResource Caption}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10" />
       <TextBlock Text="{Binding Selected.DisplayName}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
       <TextBlock Text="{Binding Selected.RepositoryPath}" Style="{StaticResource Caption}" Margin="0,6,0,18" TextWrapping="Wrap" />
       <WrapPanel Margin="0,0,0,24">
        <ui:Button Content="Refresh" Click="OnRefresh" Margin="0,0,8,6" />
        <ui:Button Content="Project defaults" Click="OnEdit" Margin="0,0,8,6" />
        <ui:Button Content="Open folder" Click="OnOpenProject" Margin="0,0,8,6" />
        <ui:Button Content="Remove project" Click="OnRemove" Margin="0,0,0,6" />
       </WrapPanel>
       <Border Style="{StaticResource Card}" Visibility="{Binding SnapshotUnavailable, Converter={StaticResource BoolVisibility}}">
        <StackPanel><TextBlock Text="{Binding RepositoryStatus}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding RepositoryDetail}" Style="{StaticResource Caption}" /></StackPanel>
       </Border>
       <StackPanel Visibility="{Binding HasSnapshot, Converter={StaticResource BoolVisibility}}">
        <Border Style="{StaticResource Card}">
         <StackPanel>
          <TextBlock Text="{Binding WorkingState}" Style="{StaticResource SectionTitle}" />
          <Grid Margin="0,8,0,4">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
           <StackPanel Margin="0,0,16,0"><TextBlock Text="CURRENT BRANCH" Style="{StaticResource Caption}" FontSize="11" /><TextBlock Text="{Binding Snapshot.Branch}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel>
           <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="DEFAULT BASE" Style="{StaticResource Caption}" FontSize="11" /><TextBlock Text="{Binding BaseLabel}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel>
           <StackPanel Grid.Column="2"><TextBlock Text="TRACKED CHANGES" Style="{StaticResource Caption}" FontSize="11" /><TextBlock Text="{Binding Snapshot.TrackedChangedCount}" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0" /><TextBlock Text="{Binding Snapshot.UntrackedCount, StringFormat='Untracked: {0}'}" Style="{StaticResource Caption}" FontSize="11" /></StackPanel>
          </Grid>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Visibility="{Binding HasBaseWarning, Converter={StaticResource BoolVisibility}}" BorderBrush="#D99043"><TextBlock Text="{Binding Snapshot.BaseWarning}" TextWrapping="Wrap" /></Border>
        <Border Style="{StaticResource Card}">
         <StackPanel><TextBlock Text="Working changes" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding Snapshot.DiffSummary}" TextWrapping="Wrap" FontSize="15" />
          <TextBlock Text="Tracked line changes and untracked file counts are shown separately. Local remote-tracking refs may be out of date." Style="{StaticResource Caption}" Margin="0,10,0,0" />
         </StackPanel>
        </Border>
        <Expander Header="Git details" Margin="0,0,0,16" HorizontalContentAlignment="Stretch">
         <StackPanel Margin="16">
          <WrapPanel Margin="0,0,0,16">
           <TextBlock Text="{Binding Snapshot.StagedCount, StringFormat='Staged: {0}'}" Margin="0,0,24,0" />
           <TextBlock Text="{Binding Snapshot.UnstagedCount, StringFormat='Unstaged: {0}'}" Margin="0,0,24,0" />
           <TextBlock Text="{Binding Snapshot.UntrackedCount, StringFormat='Untracked: {0}'}" Margin="0,0,24,0" />
           <TextBlock Text="{Binding Snapshot.ConflictCount, StringFormat='Conflicts: {0}'}" />
          </WrapPanel>
          <TextBlock Text="HEAD" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Snapshot.HeadSha, TargetNullValue='No commits yet'}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,14" />
          <TextBlock Text="MERGE BASE" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Snapshot.MergeBaseSha, TargetNullValue='Not available'}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0" />
         </StackPanel>
        </Expander>
        <TextBlock Text="{Binding Refreshed}" Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,24" />
       </StackPanel>
       <Border Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="Ready for the next step" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{Binding ProfileLabel, StringFormat='Default profile: {0}'}" Margin="0,0,0,8" />
        <TextBlock Text="Choose the project's Reviews area to prepare a scoped, profile based review and inspect its history." Style="{StaticResource Caption}" />
       </StackPanel></Border>
      </StackPanel>
     </StackPanel>
     <StackPanel Visibility="{Binding ShowReviews, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="Reviews" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,8" />
      <TextBlock Text="{Binding Selected.DisplayName}" Style="{StaticResource Caption}" Margin="0,0,0,20" />
      <WrapPanel Margin="0,0,0,16">
       <ui:Button Content="History" Click="OnShowHistory" Margin="0,0,8,6" />
       <ui:Button Content="New review" Appearance="Primary" Click="OnNewReview" Margin="0,0,8,6" />
      </WrapPanel>
      <StackPanel Visibility="{Binding ShowNewReview, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="Choose a review scope" Style="{StaticResource SectionTitle}" />
      <ComboBox x:Name="ScopePicker" SelectedValue="{Binding Scope, Mode=OneWay}" Width="300" HorizontalAlignment="Left" SelectionChanged="OnReviewInputChanged" Margin="0,8,0,16" />
      <TextBlock Text="Choose changed paths" Style="{StaticResource SectionTitle}" Visibility="{Binding IsSelectedPaths, Converter={StaticResource BoolVisibility}}" />
      <ListBox x:Name="ChangedPaths" ItemsSource="{Binding ReviewPaths}" SelectionMode="Extended" DisplayMemberPath="Display" Height="150" Visibility="{Binding IsSelectedPaths, Converter={StaticResource BoolVisibility}}" SelectionChanged="OnReviewInputChanged" />
      <WrapPanel IsEnabled="{Binding Interactive}" Margin="0,0,0,8">
       <StackPanel Margin="0,0,16,8"><TextBlock Text="Model" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding Models}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedModel, Mode=TwoWay}" MinWidth="220" AutomationProperties.Name="Review model" /></StackPanel>
       <StackPanel Margin="0,0,0,8"><TextBlock Text="Reasoning" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding EffortChoices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedReasoningChoice, Mode=TwoWay}" MinWidth="140" AutomationProperties.Name="Review reasoning" /></StackPanel>
      </WrapPanel>
      <TextBlock Text="{Binding AutoExplanation}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />
      <TextBlock Text="{Binding ReasoningHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />
      <TextBlock Text="{Binding ExecutionNotice}" TextWrapping="Wrap" Margin="0,0,0,12" />
      <Border Style="{StaticResource Card}" Margin="0,0,0,12"><TextBlock Text="{Binding PromptSizeDisplay}" TextWrapping="Wrap" /></Border>
      <TextBlock Text="Choose one or more review profiles" Style="{StaticResource SectionTitle}" Margin="0,20,0,8" />
      <ItemsControl ItemsSource="{Binding ProfileChoices}"><ItemsControl.ItemTemplate><DataTemplate>
       <CheckBox Content="{Binding Profile.Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,4" />
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <WrapPanel Margin="0,18,0,12">
       <ui:Button Content="Preview final prompt" Click="OnPreviewPrompt" Margin="0,0,8,6" />
       <ui:Button Content="Start review" Appearance="Primary" IsEnabled="{Binding Interactive}" Click="OnStartReview" Margin="0,0,8,6" />
       <ui:Button Content="Cancel review" IsEnabled="{Binding IsReviewRunning}" Click="OnCancelReview" Margin="0,0,8,6" />
      </WrapPanel>
      </StackPanel>
      <TextBlock Text="{Binding ReviewProgress}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
      <StackPanel Visibility="{Binding ShowHistoryList, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="Recent reviews" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
      <TextBlock Text="{Binding HistoryStatus}" TextWrapping="Wrap" Margin="0,8,0,16" Visibility="{Binding EmptyHistory, Converter={StaticResource BoolVisibility}}" />
      <ListBox x:Name="HistoryList" ItemsSource="{Binding ReviewHistory}" SelectionChanged="OnHistorySelected" MaxHeight="500" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Margin="0,0,0,16">
       <ListBox.ItemTemplate><DataTemplate>
        <StackPanel Margin="4,6">
         <DockPanel><TextBlock Text="{Binding Details.TimeLabel}" DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Details.StatusLabel}" FontWeight="SemiBold" TextWrapping="Wrap" /></DockPanel>
         <TextBlock Text="{Binding Details.ContextLabel}" TextWrapping="Wrap" Margin="0,3,0,0" />
         <TextBlock Text="{Binding Details.ProfilesLabel}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
        </StackPanel>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      </StackPanel>
      <Border Style="{StaticResource Card}" Visibility="{Binding ShowReviewDetail, Converter={StaticResource BoolVisibility}}">
       <StackPanel>
        <TextBlock Text="{Binding Details.StatusLabel}" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{Binding Details.SeveritySummary}" FontWeight="SemiBold" Margin="0,4,0,0" />
        <TextBlock Text="{Binding Details.ContextSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
        <TextBlock Text="{Binding Details.ProfilesLabel}" TextWrapping="Wrap" Margin="0,4,0,8" />
        <TextBlock Text="{Binding Details.ExecutionText}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <Expander Header="Review usage" Visibility="{Binding Details.HasUsage, Converter={StaticResource BoolVisibility}}" HorizontalContentAlignment="Stretch" Margin="0,0,0,8"><TextBlock Text="{Binding Details.UsageText}" TextWrapping="Wrap" Margin="8" /></Expander>
        <TextBlock Text="{Binding Details.Outcome}" TextWrapping="Wrap" Margin="0,8,0,8" />
        <TextBlock Text="{Binding Details.ResultSummary}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <WrapPanel Margin="0,0,0,12">
         <ui:Button Content="Review again" Click="OnReviewAgain" Margin="0,0,8,6" />
         <WrapPanel Visibility="{Binding CanHandoffLatest, Converter={StaticResource BoolVisibility}}">
          <ui:Button Content="Copy result" Click="OnCopyResult" Margin="0,0,8,6" />
          <ui:Button Content="Copy for ChatGPT" Click="OnCopyChatGPT" Margin="0,0,8,6" />
          <ui:Button Content="Copy for Codex" Click="OnCopyCodex" Margin="0,0,8,6" />
         </WrapPanel>
        </WrapPanel>
        <Expander Header="Captured repository and review details" HorizontalContentAlignment="Stretch" Margin="0,0,0,12">
         <StackPanel>
          <TextBox Text="{Binding Details.SnapshotText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" AcceptsReturn="True" Margin="8" />
          <TextBlock Text="{Binding Details.OutputStructureText}" TextWrapping="Wrap" Margin="8" />
         </StackPanel>
        </Expander>
        <Expander Header="Review explanation" Visibility="{Binding Details.HasDiagnostic, Converter={StaticResource BoolVisibility}}" HorizontalContentAlignment="Stretch" Margin="0,0,0,12">
         <TextBlock Text="{Binding Details.Diagnostic}" TextWrapping="Wrap" Margin="8" />
        </Expander>
        <StackPanel Visibility="{Binding Details.HasFindings, Converter={StaticResource BoolVisibility}}">
         <WrapPanel>
          <StackPanel Margin="0,0,10,8"><TextBlock Text="Severity" Style="{StaticResource Caption}" /><ComboBox ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding SeverityFilter}" MinWidth="95" AutomationProperties.Name="Severity filter" /></StackPanel>
          <StackPanel Margin="0,0,10,8"><TextBlock Text="Certainty" Style="{StaticResource Caption}" /><ComboBox ItemsSource="{Binding CertaintyOptions}" SelectedItem="{Binding CertaintyFilter}" MinWidth="110" AutomationProperties.Name="Certainty filter" /></StackPanel>
          <StackPanel Margin="0,0,10,8"><TextBlock Text="Category" Style="{StaticResource Caption}" /><ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding CategoryFilter}" MinWidth="110" MaxWidth="200" AutomationProperties.Name="Category filter" /></StackPanel>
          <StackPanel Margin="0,0,10,8"><TextBlock Text="Search title or file" Style="{StaticResource Caption}" /><TextBox Text="{Binding FindingSearch, UpdateSourceTrigger=PropertyChanged}" Width="190" AutomationProperties.Name="Search findings" /></StackPanel>
          <ui:Button Content="Clear filters" Click="OnClearFilters" VerticalAlignment="Bottom" Margin="0,0,0,8" />
         </WrapPanel>
         <TextBlock Text="{Binding FilterCount}" Style="{StaticResource Caption}" Margin="0,4,0,12" />
         <TextBlock Text="No findings match these filters." Visibility="{Binding NoFilterMatches, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,16" />
         <Grid MinHeight="160" MaxHeight="500">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <ListBox ItemsSource="{Binding ReviewFindings}" SelectedItem="{Binding SelectedFinding}" Visibility="{Binding ShowFindingList, Converter={StaticResource BoolVisibility}}" Width="220" Margin="0,0,16,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
           <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6">
            <TextBlock Text="{Binding Classification}" FontSize="11" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,4" />
            <TextBlock Text="{Binding Location}" FontSize="11" TextWrapping="Wrap" />
           </StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelectedFinding, Converter={StaticResource BoolVisibility}}">
           <StackPanel Margin="0,0,12,8">
            <TextBlock Text="{Binding SelectedFinding.Classification}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedFinding.Title}" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" Margin="0,6,0,8" />
            <TextBox Text="{Binding SelectedFinding.Location, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" FontFamily="Consolas" />
            <Button Content="Copy location" Click="OnCopyLocation" HorizontalAlignment="Left" Padding="6,3" Margin="0,4,0,12" />
            <TextBlock Text="Evidence" FontWeight="SemiBold" /><TextBox Text="{Binding SelectedFinding.Finding.Evidence, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,14" />
            <TextBlock Text="Impact" FontWeight="SemiBold" /><TextBox Text="{Binding SelectedFinding.Finding.Impact, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,14" />
            <TextBlock Text="Recommendation" FontWeight="SemiBold" /><TextBox Text="{Binding SelectedFinding.Finding.Recommendation, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,8" />
            <TextBlock Text="{Binding SelectedFinding.Finding.Id, StringFormat='Finding ID: {0}'}" Style="{StaticResource Caption}" FontSize="11" />
           </StackPanel>
          </ScrollViewer>
         </Grid>
        </StackPanel>
        <Expander Header="Reviewer limitations" Visibility="{Binding Details.HasLimitations, Converter={StaticResource BoolVisibility}}" HorizontalContentAlignment="Stretch" Margin="0,12,0,0"><TextBlock Text="{Binding Details.Limitations}" TextWrapping="Wrap" Margin="8" /></Expander>
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel Visibility="{Binding ShowProfiles, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="Review profiles" FontSize="30" FontWeight="SemiBold" />
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Shared Reviewer Policy" Style="{StaticResource SectionTitle}" />
       <TextBlock Text="Applied to every review" Style="{StaticResource Caption}" Margin="0,0,0,10" />
       <TextBox Text="{Binding SharedPolicyText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="180" VerticalScrollBarVisibility="Auto" />
      </StackPanel></Border>
      <TextBlock Text="Each selected profile adds its own review lens to the shared policy." Style="{StaticResource Caption}" Margin="0,10,0,16" />
      <ListBox x:Name="ProfileDetails" ItemsSource="{Binding Profiles}" SelectionChanged="OnProfileSelected" DisplayMemberPath="Name" MinHeight="100" />
      <Border Style="{StaticResource Card}" Visibility="{Binding HasSelectedProfile, Converter={StaticResource BoolVisibility}}"><StackPanel>
       <TextBlock Text="{Binding SelectedProfile.Name}" Style="{StaticResource SectionTitle}" />
       <TextBlock Text="{Binding SelectedProfile.Description}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
       <TextBlock Text="Added to the Shared Reviewer Policy when selected for a review." Style="{StaticResource Caption}" Margin="0,0,0,10" />
       <TextBox Text="{Binding SelectedProfile.Instructions, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="180" VerticalScrollBarVisibility="Auto" />
      </StackPanel></Border>
      <TextBlock Text="Built-in profiles · Version 1 · Custom editing and cross-repository reviews are not available." Style="{StaticResource Caption}" />
     </StackPanel>
     <StackPanel Visibility="{Binding ShowSettings, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,24" />
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
       <CheckBox x:Name="RefreshSetting" Content="Refresh repository state when returning to the app" IsChecked="{Binding State.RefreshOnActivate, Mode=OneWay}" />
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
       <TextBlock Text="Color theme" Margin="0,0,0,8" />
       <ComboBox x:Name="ThemeSetting" Width="220" HorizontalAlignment="Left" SelectedValuePath="Content" SelectedValue="{Binding State.Theme, Mode=OneWay}" AutomationProperties.Name="Color theme">
        <ComboBoxItem Content="System" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" />
       </ComboBox>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Review defaults" Style="{StaticResource SectionTitle}" />
       <TextBlock Text="Default review profiles for new projects" Margin="0,0,0,8" />
       <ItemsControl ItemsSource="{Binding ProfileChoices}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Profile.Name}" IsChecked="{Binding IsDefault, Mode=TwoWay}" Margin="0,3" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock Text="Existing projects keep their own defaults." Style="{StaticResource Caption}" Margin="0,10,0,0" />
      </StackPanel></Border>
      <ui:Button Content="Save settings" Appearance="Primary" Click="OnSaveSettings" Margin="0,0,0,24" />
      <TextBlock x:Name="SettingsSaved" Style="{StaticResource Caption}" Margin="0,0,0,12" />
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Copilot account" Style="{StaticResource SectionTitle}" />
       <TextBlock Text="{Binding AccountStatus}" FontWeight="SemiBold" Margin="0,0,0,8" />
       <TextBlock Text="{Binding AccountDetail}" Style="{StaticResource Caption}" />
       <TextBlock Text="Copilot usage" FontWeight="SemiBold" Margin="0,16,0,8" />
       <TextBlock Text="{Binding CopilotUsage}" TextWrapping="Wrap" Style="{StaticResource Caption}" />
       <WrapPanel Margin="0,12,0,0">
        <ui:Button Content="Refresh status" Click="OnRefreshAccount" Margin="0,0,8,6" />
         <ui:Button Content="Sign in with GitHub" IsEnabled="{Binding CanSignIn}" ToolTip="Opens the official Copilot browser sign-in flow when setup checks pass." Click="OnSignIn" Margin="0,0,8,6" />
        <ui:Button Content="Switch account" IsEnabled="{Binding CanSwitchAccount}" ToolTip="This Copilot CLI version has no supported noninteractive sign-out command." Click="OnSwitchAccount" Margin="0,0,8,6" />
        <ui:Button Content="Sign out" IsEnabled="{Binding CanSignOut}" ToolTip="This Copilot CLI version has no supported noninteractive sign-out command." Click="OnSignOut" Margin="0,0,8,6" />
       </WrapPanel>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Model compatibility" Style="{StaticResource SectionTitle}" />
       <TextBlock Text="{Binding ModelMetadataStatus}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
       <TextBlock Text="Live discovery describes account availability. Only valid certified models can review projects. Small compatibility tests can consume allowance; large-context tests use a very large synthetic prompt and can cost materially more. Exact cost is not known beforehand. No customer repository is used." Style="{StaticResource Caption}" />
       <TextBlock Text="Current model rates come from live Copilot metadata and can change. Rates and multipliers are not an exact review cost. Account allowance is shown above; completed reviews record actual emitted usage separately." Style="{StaticResource Caption}" Margin="0,6,0,0" />
       <TextBlock Text="{Binding CompatibilityProgress}" TextWrapping="Wrap" Margin="0,8" />
       <ui:Button Content="Cancel compatibility test" Click="OnCancelCompatibility" Visibility="{Binding IsCompatibilityTesting, Converter={StaticResource BoolVisibility}}" />
       <TextBlock Text="{Binding CompatibilityResult}" TextWrapping="Wrap" Margin="0,8" />
       <ItemsControl ItemsSource="{Binding CompatibilityModels}"><ItemsControl.ItemTemplate><DataTemplate>
        <StackPanel Margin="0,12,0,0">
         <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
         <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
         <TextBlock Text="{Binding BillingDisplay}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,4,0,0" />
         <ui:Button Content="{Binding TestLabel}" IsEnabled="{Binding CanTest}" Tag="{Binding}" Click="OnTestCompatibility" HorizontalAlignment="Left" Margin="0,6" />
         <ui:Button Content="{Binding LargeTestLabel}" IsEnabled="{Binding CanTestLarge}" Tag="{Binding}" Click="OnTestLargeCompatibility" HorizontalAlignment="Left" Margin="0,0,0,6" />
         <Expander Header="Certification evidence"><TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" /></Expander>
        </StackPanel>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Expander Header="Compatibility policy" Margin="0,12,0,0"><TextBlock Text="{Binding CompatibilityPolicy}" TextWrapping="Wrap" /></Expander>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Data and history" Style="{StaticResource SectionTitle}" />
       <TextBlock Text="Project registrations, review history and preferences are stored locally. Removing a project only removes its registration; repository files stay in place." Style="{StaticResource Caption}" />
       <TextBlock Text="{Binding DataDirectory}" TextWrapping="Wrap" Margin="0,12,0,12" />
       <ui:Button Content="Open data folder" Click="OnOpenData" />
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
       <TextBlock Text="AI Review Desk · 0.1.0 preview" FontWeight="SemiBold" Margin="0,0,0,8" />
       <TextBlock Text="A focused workspace for independent code review. Built with .NET 10, WPF UI and the .NET Community Toolkit (MIT)." Style="{StaticResource Caption}" />
      </StackPanel></Border>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Grid Grid.Row="2">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,16,4" Visibility="{Binding IsCompatibilityTesting, Converter={StaticResource BoolVisibility}}">
    <TextBlock Text="{Binding CompatibilityProgress}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" Margin="0,0,12,0" />
    <ui:Button Content="Cancel compatibility test" Click="OnCancelCompatibility" />
   </StackPanel>
   <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Loading repository state" />
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,16,4" Visibility="{Binding IsReviewRunning, Converter={StaticResource BoolVisibility}}">
    <TextBlock Text="{Binding ReviewProgress}" VerticalAlignment="Center" Margin="0,0,12,0" />
    <ui:Button Content="Cancel review" Click="OnCancelReview" />
   </StackPanel>
  </Grid>
 </Grid>
</ui:FluentWindow>
