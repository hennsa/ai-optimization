<ui:FluentWindow x:Class="AIReviewDesk.App.ProjectDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="Project defaults" Width="570" Height="720" ResizeMode="CanResize" MinWidth="470" MinHeight="360" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
 WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <ui:TitleBar Title="Project defaults" ShowMaximize="False" ShowMinimize="False" />
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28,12,28,12">
   <TextBlock x:Name="Heading" Text="Make this project yours" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
   <TextBlock Text="We found the Git root. These defaults stay on this PC." Style="{StaticResource Caption}" Margin="0,0,0,22" />
   <Label Content="Display name" Target="{Binding ElementName=NameInput}" Padding="0,0,0,7" />
   <TextBox x:Name="NameInput" MaxLength="100" AutomationProperties.Name="Display name" Margin="0,0,0,16" />
   <TextBlock Text="Repository folder" Margin="0,0,0,7" />
   <TextBox x:Name="PathInput" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Repository folder" Margin="0,0,0,16" />
   <Label Content="Default base branch or ref" Target="{Binding ElementName=BaseInput}" Padding="0,0,0,7" />
   <ComboBox x:Name="BaseInput" IsEditable="True" IsTextSearchEnabled="False" AutomationProperties.Name="Default base branch or ref" />
   <TextBlock Text="Choose a local ref, or enter one to use after it becomes available. Leave blank for automatic selection. No remotes are fetched." Style="{StaticResource Caption}" FontSize="12" Margin="0,7,0,16" />
   <TextBlock Text="Default review profiles" FontWeight="SemiBold" Margin="0,12,0,7" />
   <TextBlock Text="Selected profiles are combined for each review." Style="{StaticResource Caption}" Margin="0,0,0,6" />
   <ItemsControl x:Name="ProfileInput"><ItemsControl.ItemTemplate><DataTemplate>
    <CheckBox Content="{Binding Profile.Name}" IsChecked="{Binding IsDefault, Mode=TwoWay}" Margin="0,3" />
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock x:Name="Validation" Foreground="#D99043" TextWrapping="Wrap" Margin="0,12,0,0" />
  </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="28,0,28,24">
   <ui:Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
   <ui:Button x:Name="SaveButton" Content="Save defaults" Appearance="Primary" IsDefault="True" Click="OnSave" />
  </StackPanel>
 </Grid>
</ui:FluentWindow>
